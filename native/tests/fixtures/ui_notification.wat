(component
  (type $ui (instance
    (export "render-to-text-card" (func (param "id" string) (param "text" string)))
  ))
  (import "astrobox:psys-host-v4/ui" (instance $ui (type $ui)))
  (alias export $ui "render-to-text-card" (func $render))
  (type $timer (instance
    (export "set-timeout" (func (param "delay" u64) (param "payload" string) (result u64)))
  ))
  (import "astrobox:psys-host-v4/timer" (instance $timer (type $timer)))
  (alias export $timer "set-timeout" (func $set-timeout))
  (core module $memory
    (memory (export "memory") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 4096))
    (data (i32.const 0) "Background")
  )
  (core instance $memory (instantiate $memory))
  (core func $lower (canon lower (func $render) (memory (core memory $memory "memory"))))
  (core func $lower-timer (canon lower (func $set-timeout) (memory (core memory $memory "memory"))))
  (core module $wrapper
    (import "" "render" (func $render (param i32 i32 i32 i32)))
    (import "" "timer" (func $timer (param i64 i32 i32) (result i64)))
    (func (export "run")
      (call $render (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 10))
      (drop (call $timer (i64.const 30) (i32.const 0) (i32.const 0))))
    (func (export "run-event") (param i32 i32 i32)
      (call $render (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 10)))
  )
  (core instance $wrapper (instantiate $wrapper (with "" (instance (export "render" (func $lower)) (export "timer" (func $lower-timer))))))
  (type $event (enum "timer"))
  (func $on-event (param "event" $event) (param "payload" string)
    (canon lift (core func $wrapper "run-event") (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (instance $events (export "event-type" (type $event)) (export "on-event" (func $on-event)))
  (export "astrobox:psys-plugin-v4/event" (instance $events))
  (func (export "on-load") (canon lift (core func $wrapper "run")))
)
