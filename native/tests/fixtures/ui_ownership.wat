(component
  (type $ui (instance
    (export "element" (type $element (sub resource)))
    (type $kind (enum "BUTTON" "INPUT" "SELECT" "OPTION" "IMAGE" "VIDEO" "AUDIO" "SVG" "DIV" "SPAN" "P" "TEXTAREA" "SWITCH" "SLIDER" "PROGRESS" "GRID" "SCROLL-AREA" "CODE" "CARD" "TABS-ROOT" "TABS-LIST" "TABS-TRIGGER" "TABS-CONTENT" "CONTEXT-MENU-ROOT" "CONTEXT-MENU-TRIGGER" "CONTEXT-MENU-CONTENT" "CONTEXT-MENU-ITEM" "CONTEXT-MENU-SEPARATOR" "DIALOG-ROOT" "DIALOG-TRIGGER" "DIALOG-CONTENT" "DIALOG-TITLE" "DIALOG-DESCRIPTION" "DIALOG-CLOSE" "DROPDOWN-MENU-ROOT" "DROPDOWN-MENU-TRIGGER" "DROPDOWN-MENU-CONTENT" "DROPDOWN-MENU-ITEM" "DROPDOWN-MENU-SEPARATOR" "TOOLTIP" "CHECKBOX" "SEPARATOR" "BADGE"))
    (export "element-type" (type $public-kind (eq $kind)))
    (export "[constructor]element" (func (param "kind" $public-kind) (param "content" (option string)) (result (own $element))))
    (export "[method]element.size" (func (param "self" (borrow $element)) (param "size" u32) (result (own $element))))
    (export "[method]element.child" (func (param "self" (borrow $element)) (param "child" (own $element)) (result (own $element))))
    (export "render" (func (param "id" string) (param "element" (own $element))))
  ))
  (import "astrobox:psys-host-v4/ui" (instance $ui (type $ui)))
  (alias export $ui "[constructor]element" (func $new))
  (alias export $ui "[method]element.size" (func $size))
  (alias export $ui "[method]element.child" (func $child))
  (alias export $ui "element" (type $element))
  (core func $drop (canon resource.drop $element))
  (alias export $ui "render" (func $render))
  (core module $memory
    (memory (export "memory") 1)
    (data (i32.const 0) "Comic heading")
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 4096))
  )
  (core instance $memory (instantiate $memory))
  (core func $new (canon lower (func $new) (memory (core memory $memory "memory"))))
  (core func $size (canon lower (func $size)))
  (core func $child (canon lower (func $child)))
  (core func $render (canon lower (func $render) (memory (core memory $memory "memory"))))
  (core module $guest
    (import "" "new" (func $new (param i32 i32 i32 i32) (result i32)))
    (import "" "size" (func $size (param i32 i32) (result i32)))
    (import "" "render" (func $render (param i32 i32 i32)))
    (import "" "child" (func $child (param i32 i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (func (export "load")
      (local $root i32)
      (local $styled i32)
      (local.set $root (call $new (i32.const 8) (i32.const 0) (i32.const 0) (i32.const 0)))
      (local.set $styled (call $child (local.get $root)
        (call $new (i32.const 10) (i32.const 1) (i32.const 0) (i32.const 13))))
      (call $drop (local.get $root))
      (call $render (i32.const 0) (i32.const 0) (local.get $styled)))
  )
  (core instance $guest (instantiate $guest (with "" (instance
    (export "new" (func $new)) (export "size" (func $size)) (export "render" (func $render)) (export "child" (func $child)) (export "drop" (func $drop))))))
  (func (export "on-load") (canon lift (core func $guest "load")))
)
